# Copy this file to .env.local and fill in values from your Supabase project.
# Database settings page: https://supabase.com/dashboard/project/<ref>/settings/database

# Transaction pooler — used by the Next.js app at runtime (serverless friendly).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-us-east-1.pooler.supabase.com:6543/postgres"

# Session pooler — used by drizzle-kit migrations and other long-lived clients.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# Public Supabase project URL (no secrets here).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Supabase service role key — server-side only, used by Server Actions to
# upload plant photos to Storage. Find it under:
# https://supabase.com/dashboard/project/<ref>/settings/api  → service_role key
# DO NOT expose this to the browser. If unset, photo uploads will fail.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
