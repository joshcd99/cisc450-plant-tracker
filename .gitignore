# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase
**/supabase/.branches
**/supabase/.temp

# drizzle
/drizzle

# claude code (per-developer settings, not shared)
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock

# raw cursor source files (the in-use cursors live in public/cursors/)
src/components/leaf-1/
src/components/leaf-1.zip

# typescript
*.tsbuildinfo
next-env.d.ts
.Rhistory
